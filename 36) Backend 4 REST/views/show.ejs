<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Single Post</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora</h1>
    <h4>Post ID: <%= post.id%></h4>
    <div class="container">
        <h4 class="username">@<%=post.username%></h4>
        <h5 class="content"><%=post.content%></h5>
    </div>
    <a href="http://localhost:8080/posts"> View all posts</a>
</body>
</html>