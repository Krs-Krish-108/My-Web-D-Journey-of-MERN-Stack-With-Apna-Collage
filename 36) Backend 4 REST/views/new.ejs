<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Post</title>
    <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
          font-family: Arial, sans-serif;
          /* color: #fff */
        }
        
        html,
        body {
          width: 100%;
          height: 100%;
        }
        
        body {
          background-color: #414040
        }

        .container{
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;    
        }

        .form{
            display: flex;
            align-items: center;
            justify-content: center;
            height: 300px;
            width: 250px;
            border: 1px, solid, #fff;
            border-radius: 8px;
        }

        .details{
            width: 180px;
            padding: 3px;
        }
        label{
            font-family: Cambria, Cochin, Georgia, Times, 'Times New Roman', serif;
            font-weight: 700;
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form">
            <form method="post" action="/posts">
                <label for="">Username</label><br>
                <input type="text" name="username" placeholder="Enter username" class="details"> 
                <br>
                <br>
                <label for="">Content</label><br>
                <textarea name="content" placeholder="Enter content" class="details" rows="7"></textarea>
                <br>
                <br>
                <button class="details">Create Post</button>
            </form>
        </div>
    </div>
</body>
</html>