<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quora</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1 class="heading">Quora</h1>
    <%for(post of posts){%>
        <div class="container">
            <h4 class="username">@<%= post.username%></h4>
            <h5 class="content"><%= post.content%></h5>
            <a href="http://localhost:8080/posts/<%= post.id %>"> View post</a>
        </div>  
        <br>  
    <%}%>
    <br>
    <br>
    <a href="http://localhost:8080/posts/new">Create new post</a>
</body>
</html>